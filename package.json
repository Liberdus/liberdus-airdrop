{
  "name": "liberdus-airdrop",
  "version": "1.0.0",
  "description": "Epoch-based Merkle airdrop contract and Hardhat test harness for Liberdus",
  "main": "index.js",
  "scripts": {
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy-local.js --network localhost",
    "fund:owner:local": "hardhat fund-owner-wallet --network localhost",
    "merkle": "node scripts/generate-merkle.js",
    "generate:test-claims": "node scripts/generate-test-claims.js --start-epoch 1",
    "publish:config:test": "node scripts/publish-frontend-config.js --env test",
    "publish:config:prod": "node scripts/publish-frontend-config.js --env prod"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.28.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0"
  }
}
